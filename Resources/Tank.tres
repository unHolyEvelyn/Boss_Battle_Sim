short_description = "Heavy defender. Absorbs hits and counters with massive force."
detailed_pages = Array[String](["The Tank has massive health and defense, at the cost of offense.  Fret not, there are ways around the low offense.", "Time your perfect parry to knock the Boss off guard and negate his damage, and the next turn unleash your powerful Counter Strike.", "Don't worry, if you get a partial parry it'll mitigate the damage, but if you miss, you stagger and the Boss deals triple damage!"])
